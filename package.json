{
    "name": "sliding-scale",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch --mode development",
        "check": "tsc --noEmit",
        "lint": "oxlint && prettier --check . && ruff check scripts && ruff format --check scripts",
        "format": "prettier --write . && ruff format scripts",
        "test": "vitest run",
        "test:watch": "vitest",
        "foundry": "run-foundry",
        "foundry:install-pf2e": "install-foundry-package .foundry-data systems https://raw.githubusercontent.com/foundryvtt/pf2e/v14-dev/system.pf2e.json",
        "foundry:install-sf2e": "install-foundry-package .foundry-data systems https://raw.githubusercontent.com/foundryvtt/pf2e/v14-dev/system.sf2e.json",
        "foundry:install-anachronism": "install-foundry-package .foundry-data modules https://raw.githubusercontent.com/foundryvtt/pf2e/v14-dev/module.sf2e-anachronism.json",
        "test:scripts": "pytest scripts"
    },
    "devDependencies": {
        "@7h3laughingman/pf2e-types": "^8.0.2",
        "oxlint": "^1.95.0",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
