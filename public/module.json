    "bugs": "https://github.com/RossRKK/sliding-scale/issues",
    "compatibility": {
        "minimum": "14",
        "verified": "14.364"
    },
    "esmodules": ["main.js"],
    "styles": ["styles.css"],
    "languages": [{ "lang": "en", "name": "English", "path": "lang/en.json" }],
    "relationships": {
        "systems": [
            { "id": "pf2e", "type": "system" },
            { "id": "sf2e", "type": "system" }
        ]
    }
